<UserControl x:Class="McModpackTool.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2">
                            <Grid>
                                <Border x:Name="SelectedBackground" Margin="-10,-7" CornerRadius="5" Background="{DynamicResource AccentBrush}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SelectedBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,30,36,28" MaxWidth="900" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [settings.title]}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [settings.subtitle]}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,26,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [settings.language]}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,24,0" Text="{Binding [settings.language_desc]}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Tag="zh_CN" Content="简体中文" />
                        <ComboBoxItem Tag="zh_HK" Content="繁體中文（香港）" />
                        <ComboBoxItem Tag="en_US" Content="English" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [settings.appearance]}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,24,0" Text="{Binding [settings.appearance_desc]}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LightTheme" GroupName="Theme" Tag="light" Style="{StaticResource SegmentStyle}" Checked="Theme_Checked" Content="{Binding [settings.light]}" />
                            <RadioButton x:Name="DarkTheme" GroupName="Theme" Tag="dark" Style="{StaticResource SegmentStyle}" Checked="Theme_Checked" Content="{Binding [settings.dark]}" />
                            <RadioButton x:Name="SystemTheme" GroupName="Theme" Tag="system" Style="{StaticResource SegmentStyle}" Checked="Theme_Checked" Content="{Binding [settings.system]}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [settings.accent]}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,24,0" Text="{Binding [settings.accent_desc]}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SwatchStyle}" Tag="#167D6A" Background="#167D6A" Click="Swatch_Click" ToolTip="#167D6A" />
                        <Button Style="{StaticResource SwatchStyle}" Tag="#2563EB" Background="#2563EB" Click="Swatch_Click" ToolTip="#2563EB" Margin="6,0,0,0" />
                        <Button Style="{StaticResource SwatchStyle}" Tag="#C2416C" Background="#C2416C" Click="Swatch_Click" ToolTip="#C2416C" Margin="6,0,0,0" />
                        <Button Style="{StaticResource SwatchStyle}" Tag="#7C3AED" Background="#7C3AED" Click="Swatch_Click" ToolTip="#7C3AED" Margin="6,0,0,0" />
                        <Button Style="{StaticResource SwatchStyle}" Tag="#D97706" Background="#D97706" Click="Swatch_Click" ToolTip="#D97706" Margin="6,0,10,0" />
                        <Button Style="{StaticResource FluentButtonStyle}" Click="CustomColor_Click" Content="{Binding [settings.custom_color]}" />
                        <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" Click="ResetColor_Click" Content="&#xE777;" ToolTip="{Binding [settings.reset_color]}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [settings.font]}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,24,0" Text="{Binding [settings.font_desc]}" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FontCombo"
                                      IsTextSearchEnabled="True"
                                      MaxDropDownHeight="320"
                                      SelectionChanged="FontCombo_SelectionChanged"
                                      ToolTip="{Binding [settings.font_desc]}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{Binding}" Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="DefaultFontButton" Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource FluentButtonStyle}"
                                    Click="DefaultFont_Click" Content="{Binding [settings.default_font]}" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,9,0,0" MinHeight="40" Padding="12,8" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}">
                            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource TextBrush}" Text="{Binding [settings.font_preview]}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
