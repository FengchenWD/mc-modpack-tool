<UserControl x:Class="McModpackTool.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:McModpackTool.App"
             Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,30,36,26" MaxWidth="1020" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="30" Text="{Binding [home.title]}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [home.subtitle]}" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Margin="0,30,0,18" Columns="3">
                <Button x:Name="MigrationHomeButton" Margin="0,0,7,0" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="Migration_Click">
                    <Border Style="{StaticResource CardStyle}" Padding="24" MinHeight="168">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="&#xE8AB;" />
                            <TextBlock Grid.Row="1" Margin="0,18,0,7" FontSize="18" FontWeight="SemiBold" Text="{Binding [home.migration]}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource HintStyle}" Text="{Binding [home.migration.desc]}" />
                        </Grid>
                    </Border>
                </Button>
                <Button x:Name="ClientPackHomeButton" Margin="7,0" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="ClientPack_Click">
                    <Border Style="{StaticResource CardStyle}" Padding="24" MinHeight="168">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="&#xE7B8;" />
                            <TextBlock Grid.Row="1" Margin="0,18,0,7" FontSize="18" FontWeight="SemiBold" Text="{Binding [home.client_pack]}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource HintStyle}" Text="{Binding [home.client_pack.desc]}" />
                        </Grid>
                    </Border>
                </Button>
                <Button x:Name="ServerHomeButton" Margin="7,0,0,0" Padding="0" Style="{StaticResource FluentButtonStyle}" Click="Server_Click">
                    <Border Style="{StaticResource CardStyle}" Padding="24" MinHeight="168">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="&#xE950;" />
                            <TextBlock Grid.Row="1" Margin="0,18,0,7" FontSize="18" FontWeight="SemiBold" Text="{Binding [home.server]}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource HintStyle}" Text="{Binding [home.server.desc]}" />
                        </Grid>
                    </Border>
                </Button>
            </UniformGrid>

            <Border Grid.Row="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="22" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="56" Height="56" VerticalAlignment="Center"
                             Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="../Assets/fengchenwd_avatar.png" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding [home.creator]}" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource HintStyle}" Text="{Binding [home.creator_desc]}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FluentButtonStyle}" Margin="0,0,8,0" Click="Bilibili_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" Margin="0,0,7,0" /><TextBlock Text="{Binding [home.bilibili]}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource FluentButtonStyle}" Click="Github_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71B;" Margin="0,0,7,0" /><TextBlock Text="{Binding [home.github]}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Button HorizontalAlignment="Left" Style="{StaticResource FluentButtonStyle}" Click="Agreement_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D7;" Margin="0,0,7,0" /><TextBlock Text="{Binding [home.agreement]}" /></StackPanel>
                </Button>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding [author]}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
