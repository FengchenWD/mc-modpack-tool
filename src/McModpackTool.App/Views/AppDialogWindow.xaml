<Window x:Class="McModpackTool.App.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:McModpackTool.App.UI"
        Width="560" MinWidth="420" MaxWidth="760" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:AppTitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

            <Grid Grid.Row="1" Margin="22,22,22,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogIcon" FontFamily="Segoe Fluent Icons" FontSize="25"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0" />
                <ScrollViewer Grid.Column="1" MaxHeight="390" Margin="15,0,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DialogMessage" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,12">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="OkButton" MinWidth="86" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Ok_Click" Content="{Binding [common.ok]}" />
                    <Button x:Name="YesButton" MinWidth="86" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Yes_Click" Content="{Binding [common.yes]}" />
                    <Button x:Name="NoButton" MinWidth="86" Style="{StaticResource FluentButtonStyle}"
                            Click="No_Click" Content="{Binding [common.no]}" />
                    <Button x:Name="CancelButton" MinWidth="86" Style="{StaticResource FluentButtonStyle}"
                            Click="Cancel_Click" Content="{Binding [common.cancel]}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
