<Window x:Class="McModpackTool.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:McModpackTool.App.UI"
        Width="520" Height="360" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:AppTitleBar Title="{Binding [settings.custom_color]}" />

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="96" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="Preview" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                            <ColumnDefinition Width="12" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="R" />
                            <TextBox x:Name="RedBox" Margin="0,5,0,0" TextChanged="Rgb_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource HintStyle}" Text="G" />
                            <TextBox x:Name="GreenBox" Margin="0,5,0,0" TextChanged="Rgb_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource HintStyle}" Text="B" />
                            <TextBox x:Name="BlueBox" Margin="0,5,0,0" TextChanged="Rgb_TextChanged" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock Style="{StaticResource HintStyle}" Text="HEX" />
                        <TextBox x:Name="HexBox" Margin="0,5,0,0" MaxLength="7" TextChanged="Hex_TextChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,12">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,9,0" MinWidth="126" Style="{StaticResource FluentButtonStyle}"
                            Click="SystemPalette_Click" Content="{Binding [settings.system_palette]}" />
                    <Button Margin="0,0,9,0" MinWidth="86" Style="{StaticResource FluentButtonStyle}"
                            IsCancel="True" Click="Cancel_Click" Content="{Binding [common.cancel]}" />
                    <Button MinWidth="86" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" Click="Confirm_Click" Content="{Binding [common.ok]}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
