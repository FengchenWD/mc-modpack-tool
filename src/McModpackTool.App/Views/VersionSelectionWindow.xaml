<Window x:Class="McModpackTool.App.Views.VersionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:McModpackTool.App.UI"
        Title="{Binding [server.version_select_title]}" Width="520" Height="250"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ui:AppTitleBar Title="{Binding [server.version_select_title]}" />
            <StackPanel Grid.Row="1" Margin="20,18,20,12">
                <TextBlock Style="{StaticResource HintStyle}" Text="{Binding [server.version_select_hint]}" />
                <ComboBox x:Name="VersionCombo" Margin="0,14,0,0" DisplayMemberPath="DisplayName" />
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="20,12">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource FluentButtonStyle}" Click="Cancel_Click" Content="{Binding [common.cancel]}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Confirm_Click" Content="{Binding [common.ok]}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
