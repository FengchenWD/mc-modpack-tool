<UserControl x:Class="McModpackTool.App.Views.ClientPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="GroupToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="26,20,26,9">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding [client.title]}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding [client.subtitle]}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,8,22,12" MaxWidth="1180" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding [client.source_path]}" />
                        <TextBox x:Name="InputPathBox" Grid.Column="1" TextChanged="InputPathBox_TextChanged" />
                        <Button x:Name="BrowseInputButton" Grid.Column="2" Margin="8,0" Style="{StaticResource FluentButtonStyle}"
                                Click="BrowseInput_Click" Content="{Binding [client.choose_directory]}" />
                        <Button x:Name="ReadButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}"
                                Click="Read_Click" Content="{Binding [client.read]}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Style="{StaticResource HintStyle}"
                                   Text="{Binding [client.source_hint]}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,5,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [client.source_overview]}" />
                            <TextBox x:Name="OverviewBox" Grid.Row="1" Height="142" Margin="0,8,0,0" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                     Padding="0" Background="Transparent" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitleStyle}" Text="{Binding [client.environment]}" />
                            <TextBlock Grid.Row="1" Margin="0,10,10,0" VerticalAlignment="Center" Text="Minecraft" />
                            <TextBox x:Name="MinecraftVersionBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" IsReadOnly="True" />
                            <TextBlock Grid.Row="2" Margin="0,10,10,0" VerticalAlignment="Center" Text="{Binding [client.loader]}" />
                            <TextBox x:Name="LoaderBox" Grid.Row="2" Grid.Column="1" Margin="0,8,8,0" IsReadOnly="True" />
                            <TextBox x:Name="LoaderVersionBox" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" IsReadOnly="True" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [client.content]}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource HintStyle}" Text="{Binding [client.content_hint]}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="SelectDefaultsButton" Style="{StaticResource FluentButtonStyle}" Margin="0,0,7,0"
                                        Click="SelectDefaults_Click" Content="{Binding [client.restore_defaults]}" />
                                <Button x:Name="ClearAllButton" Style="{StaticResource FluentButtonStyle}"
                                        Click="ClearAll_Click" Content="{Binding [client.clear_all]}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ContentGroupsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Button Style="{StaticResource GroupToggleButtonStyle}" Click="ToggleGroup_Click"
                                                                ToolTip="{Binding ToggleHint}" AutomationProperties.Name="{Binding ToggleHint}">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="{Binding ToggleGlyph}" />
                                                        </Button>
                                                        <CheckBox Grid.Column="1" IsThreeState="True" IsChecked="{Binding SelectionState, Mode=TwoWay}"
                                                                  FontWeight="SemiBold" Content="{Binding DisplayName}" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                                                   Text="{Binding Summary}" />
                                                    </Grid>
                                                    <ItemsControl Margin="28,6,0,0" ItemsSource="{Binding Items}"
                                                                  Visibility="{Binding ItemsVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="30" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="1.8*" />
                                                                        <ColumnDefinition Width="92" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                                              VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                    <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource MutedTextBrush}" Text="{Binding RelativePath}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" />
                                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right"
                                                                               Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SizeText}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,5,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitleStyle}" Text="{Binding [client.output]}" />
                            <TextBlock Grid.Row="1" Margin="0,12,12,0" VerticalAlignment="Center" Text="{Binding [client.formats]}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
                                <CheckBox x:Name="ModrinthFormatCheckBox" Margin="0,0,22,0" IsChecked="True"
                                          Checked="Format_Checked" Unchecked="Format_Unchecked" Content="Modrinth (.mrpack)" />
                                <CheckBox x:Name="CurseForgeFormatCheckBox" Checked="Format_Checked" Unchecked="Format_Unchecked"
                                          Content="CurseForge (.zip)" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Margin="0,10,10,0" VerticalAlignment="Center" Text="{Binding [client.output_dir]}" />
                            <TextBox x:Name="OutputDirectoryBox" Grid.Row="2" Grid.Column="1" Margin="0,8,8,0" />
                            <Button x:Name="BrowseOutputButton" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"
                                    Style="{StaticResource FluentButtonStyle}" Click="BrowseOutput_Click" Content="{Binding [client.browse]}" />
                            <TextBlock Grid.Row="3" Margin="0,10,10,0" VerticalAlignment="Center" Text="{Binding [client.output_name]}" />
                            <TextBox x:Name="OutputNameBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                     TextChanged="OutputNameBox_TextChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="132" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding [client.log]}" />
                            <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas"
                                     FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="{Binding [client.ready]}" />
                <ProgressBar x:Name="OperationProgress" Grid.Column="1" Height="5" Margin="18,0" VerticalAlignment="Center" Minimum="0" Maximum="1" />
                <Button x:Name="CancelButton" Grid.Column="2" Margin="0,0,9,0" Style="{StaticResource FluentButtonStyle}"
                        Visibility="Collapsed" IsEnabled="False" Click="Cancel_Click" Content="{Binding [common.cancel]}" />
                <Button x:Name="BuildButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        Click="Build_Click" Content="{Binding [client.build]}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
