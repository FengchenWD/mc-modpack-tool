<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>McModpackTool.App</RootNamespace>
    <AssemblyName>MC整合包工具</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets\mc_modpack_tool.ico')">Assets\mc_modpack_tool.ico</ApplicationIcon>
    <Version>1.0.0-beta.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>MC整合包工具</Product>
    <Authors>风尘WD</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\McModpackTool.Core\McModpackTool.Core.csproj" />
    <Resource Include="Assets\mc_modpack_tool.png" Condition="Exists('Assets\mc_modpack_tool.png')" />
    <Resource Include="Assets\fengchenwd_avatar.png" Condition="Exists('Assets\fengchenwd_avatar.png')" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES\DotNet-10.0.10-LICENSE.txt"
                      LogicalName="McModpackTool.Legal.DotNetLicense.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES\DotNet-WindowsDesktop-10.0.10-LICENSE.txt"
                      LogicalName="McModpackTool.Legal.DotNetWindowsDesktopLicense.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_LICENSES\DotNet-Runtime-10.0.10-THIRD-PARTY-NOTICES.txt"
                      LogicalName="McModpackTool.Legal.DotNetThirdPartyNotices.txt" />
  </ItemGroup>
</Project>
