<UserControl x:Class="McModpackTool.App.UI.AppTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:McModpackTool.App.UI"
             Height="40" Background="Transparent">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="12,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="18" Height="18" Source="../Assets/mc_modpack_tool.png" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:AppTitleBar}}}" />
            </Grid>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Visibility="{Binding MinimizeVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:AppTitleBar}}}"
                        Style="{StaticResource AppCaptionButtonStyle}" Content="&#xE921;"
                        AutomationProperties.Name="{Binding [window.minimize]}" ToolTip="{Binding [window.minimize]}"
                        Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Visibility="{Binding MaximizeVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:AppTitleBar}}}"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="{Binding [window.maximize_restore]}" ToolTip="{Binding [window.maximize_restore]}"
                        Click="MaximizeRestore_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE922;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource AppCaptionCloseButtonStyle}" Content="&#xE8BB;"
                        AutomationProperties.Name="{Binding [window.close]}" ToolTip="{Binding [window.close]}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
