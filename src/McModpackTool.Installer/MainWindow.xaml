<Window x:Class="McModpackTool.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="780"
        Height="580"
        MinWidth="680"
        MinHeight="500"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Title="MC整合包工具安装程序">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Margin="12,5,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="24" Height="24" Source="Assets/mc_modpack_tool.png" Margin="0,0,8,0" />
                    <TextBlock Text="MC整合包工具安装程序" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButtonStyle}" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最小化" AutomationProperties.Name="最小化">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="关闭" AutomationProperties.Name="关闭">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,14,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Image Width="118" Height="118" Source="Assets/mc_modpack_tool.png"
                               HorizontalAlignment="Center" Margin="0,10,0,18" />
                        <TextBlock Text="MC整合包工具" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="v1.0.0-beta.6.1" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,18" />
                        <TextBlock Text="快速迁移、打包 Minecraft 整合包，支持客户端与服务端工作流。"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" LineHeight="20" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                                Padding="10" Margin="0,20,0,0">
                            <TextBlock Text="制作：风尘WD" Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="安装设置" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="选择安装位置并确认许可后即可开始安装。" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,18" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="安装位置" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="建议安装到当前用户的本地程序目录。" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathBox" VerticalContentAlignment="Center" />
                                    <Button x:Name="BrowseInstallButton" Grid.Column="1" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0"
                                            Click="BrowseInstall_Click" Content="浏览..." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="快捷方式" FontSize="15" FontWeight="SemiBold" />
                                <CheckBox x:Name="StartMenuCheckBox" Content="创建开始菜单快捷方式" IsChecked="True" />
                                <CheckBox x:Name="DesktopCheckBox" Content="创建桌面快捷方式" IsChecked="False" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="许可说明" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="自研代码采用 PolyForm Noncommercial 1.0.0；自研美术、文档、Logo、图像和文字资源采用 CC BY-NC-SA 4.0，按资源领域分别授权。第三方依赖保留其原有许可证。"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           LineHeight="19" Margin="0,6,0,5" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <Button Style="{StaticResource ButtonStyle}" Content="PolyForm" Click="PolyForm_Click" />
                                    <Button Style="{StaticResource ButtonStyle}" Content="CC BY-NC-SA 4.0"
                                            Margin="8,0,0,0" Click="CreativeCommons_Click" />
                                </StackPanel>
                                <CheckBox x:Name="AgreementCheckBox"
                                          Content="我已阅读并同意用户协议及上述许可说明"
                                          Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="2,0,0,8" />
                        <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" Margin="0,0,0,7" />
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LaunchButton" Grid.Column="0" Style="{StaticResource ButtonStyle}"
                                    Content="安装后启动" IsEnabled="False" Click="Launch_Click"
                                    HorizontalAlignment="Left" />
                            <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="开始安装" Click="Install_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
